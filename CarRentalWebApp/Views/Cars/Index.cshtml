@model IEnumerable<CarRentalWebApp.Models.CarModel>

@{
    ViewData["Title"] = "Filo Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1 class="hero-title m-0" style="font-size: 2.2rem;">Araçlar</h1>
    <a asp-action="Create" class="btn btn-premium">Yeni Araç Ekle</a>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 mb-0" style="background: rgba(13, 202, 240, 0.1); color: #0dcaf0;">Listelenecek araç bulunamadı.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Brand)</th>
                        <th>@Html.DisplayNameFor(model => model.Model)</th>
                        <th>@Html.DisplayNameFor(model => model.Year)</th>
                        <th>@Html.DisplayNameFor(model => model.PlateNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.DailyPrice)</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td style="font-weight: 500;">@Html.DisplayFor(modelItem => item.Brand)</td>
                            <td>@Html.DisplayFor(modelItem => item.Model)</td>
                            <td>@Html.DisplayFor(modelItem => item.Year)</td>
                            <td style="font-family: monospace; color: var(--color-text-muted);">@Html.DisplayFor(modelItem => item.PlateNumber)</td>
                            <td style="color: var(--color-accent-gold);">@item.DailyPrice.ToString("C")</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge" style="background: rgba(25, 135, 84, 0.2); color: #20c997; border: 1px solid rgba(32, 201, 151, 0.3);">Müsait</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border: 1px solid rgba(255, 107, 107, 0.3);">Kirada</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-2" style="border-color: rgba(255,255,255,0.2);">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm" style="background: rgba(220, 53, 69, 0.1); color: #ff6b6b; border: 1px solid rgba(220, 53, 69, 0.3);">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
