@model IEnumerable<CarRentalWebApp.Models.Car>

@{
    ViewData["Title"] = "Araçlar";
}

<h1>Araçlar</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Araç Ekle</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Listelenecek araç bulunamadı.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Brand)</th>
                <th>@Html.DisplayNameFor(model => model.Model)</th>
                <th>@Html.DisplayNameFor(model => model.Year)</th>
                <th>@Html.DisplayNameFor(model => model.PlateNumber)</th>
                <th>@Html.DisplayNameFor(model => model.DailyPrice)</th>
                <th>@Html.DisplayNameFor(model => model.IsAvailable)</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Brand)</td>
                    <td>@Html.DisplayFor(modelItem => item.Model)</td>
                    <td>@Html.DisplayFor(modelItem => item.Year)</td>
                    <td>@Html.DisplayFor(modelItem => item.PlateNumber)</td>
                    <td>@item.DailyPrice.ToString("C")</td>
                    <td>
                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">Müsait</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Kirada</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
