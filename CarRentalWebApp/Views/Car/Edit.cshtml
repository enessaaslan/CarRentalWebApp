@model CarRentalWebApp.Models.Car

@{
    ViewData["Title"] = "Araç Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-gold me-3" style="padding: 0.4rem 0.8rem;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="page-title mb-0">Araç Bilgilerini Güncelle</h2>
        </div>

        <div class="glass-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Brand" class="form-label">Marka</label>
                        <input asp-for="Brand" class="form-control form-control-dark" />
                        <span asp-validation-for="Brand" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Model" class="form-label">Model</label>
                        <input asp-for="Model" class="form-control form-control-dark" />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Year" class="form-label">Yıl</label>
                        <input asp-for="Year" class="form-control form-control-dark" />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PlateNumber" class="form-label">Plaka</label>
                        <input asp-for="PlateNumber" class="form-control form-control-dark" />
                        <span asp-validation-for="PlateNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="DailyPrice" class="form-label">Günlük Fiyat (₺)</label>
                        <input asp-for="DailyPrice" class="form-control form-control-dark" type="number" step="0.01" />
                        <span asp-validation-for="DailyPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsAvailable" role="switch" id="isAvailableSwitch" style="border-color: var(--primary-gold); background-color: transparent;">
                            <label class="form-check-label ms-2 text-white" for="isAvailableSwitch">Araç Kiralanabilir Durumda</label>
                        </div>
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-gold py-3 text-uppercase fw-bold letter-spacing-1">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
