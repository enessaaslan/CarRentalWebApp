@model IEnumerable<CarRentalWebApp.Models.Customer>

@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">Müşteriler</h2>
    <a asp-action="Create" class="btn btn-gold">
        <i class="bi bi-person-plus-fill me-2"></i>Yeni Müşteri Ekle
    </a>
</div>

<div class="glass-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dark-custom">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-dark rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; border: 1px solid var(--primary-gold);">
                                    <i class="bi bi-person text-gold"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-white">@item.Name @item.LastName</h6>
                                </div>
                            </div>
                        </td>
                        <td>
                            <a href="mailto:@item.Email" class="text-muted text-decoration-none hover-gold">
                                <i class="bi bi-envelope me-2"></i>@item.Email
                            </a>
                        </td>
                        <td>
                            <a href="tel:@item.PhoneNumber" class="text-muted text-decoration-none hover-gold">
                                <i class="bi bi-telephone me-2"></i>@item.PhoneNumber
                            </a>
                        </td>
                        <td class="text-muted">
                            @item.RegistrationDate.ToString("dd MMM yyyy")
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-gold me-2" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger-custom" title="Sil">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (!Model.Any())
        {
            <div class="text-center py-5 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-white">Kayıtlı Müşteri Bulunamadı</h5>
                <p class="text-muted mb-0">Listede gösterilecek herhangi bir müşteri kaydı yok.</p>
            </div>
        }
    </div>
</div>

<style>
    .hover-gold:hover { color: var(--primary-gold) !important; transition: color 0.2s; }
</style>
