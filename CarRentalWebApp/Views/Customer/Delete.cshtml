@model CarRentalWebApp.Models.Customer

@{
    ViewData["Title"] = "Müşteri Sil";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card text-center position-relative overflow-hidden">
            <!-- Uyarı İkonu -->
            <div class="mb-4 mt-2">
                <i class="bi bi-person-x-fill text-danger" style="font-size: 4rem; filter: drop-shadow(0 0 10px rgba(220,53,69,0.5));"></i>
            </div>
            
            <h3 class="text-white mb-3">Müşteri kaydını silmek istiyor musunuz?</h3>
            <p class="text-muted mb-4">Bu müşteriye ait tüm veriler kalıcı olarak sistemden kaldırılacaktır.</p>
            
            <div class="p-4 rounded mb-4 text-start" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Ad Soyad:</span>
                    <strong class="text-gold">@Model.Name @Model.LastName</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">E-posta:</span>
                    <span class="text-white">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Telefon:</span>
                    <span class="text-white">@Model.PhoneNumber</span>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3">
                    <a asp-action="Index" class="btn btn-outline-gold flex-grow-1 py-2">Vazgeç</a>
                    <button type="submit" class="btn btn-danger-custom flex-grow-1 py-2">Evet, Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>
