@model IEnumerable<CarRentalWebApp.Models.Customer>

@{
    ViewData["Title"] = "Müşteri Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1 class="hero-title m-0" style="font-size: 2.2rem;">Müşteriler</h1>
    <a asp-action="Create" class="btn btn-premium">Yeni Müşteri Ekle</a>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 mb-0" style="background: rgba(13, 202, 240, 0.1); color: #0dcaf0;">Listelenecek müşteri bulunamadı.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.LastName)</th>
                        <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td style="font-weight: 500; color: var(--color-accent-gold);">@Html.DisplayFor(modelItem => item.Name)</td>
                            <td style="font-weight: 500;">@Html.DisplayFor(modelItem => item.LastName)</td>
                            <td style="color: var(--color-text-muted);">@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                            <td><a href="mailto:@item.Email" style="color: var(--color-text-main); text-decoration: none;">@Html.DisplayFor(modelItem => item.Email)</a></td>
                            <td style="color: var(--color-text-muted);">@item.RegistrationDate.ToShortDateString()</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-2" style="border-color: rgba(255,255,255,0.2);">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm" style="background: rgba(220, 53, 69, 0.1); color: #ff6b6b; border: 1px solid rgba(220, 53, 69, 0.3);">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
