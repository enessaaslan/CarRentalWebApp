@model IEnumerable<CarRentalWebApp.Models.Rental>

@{
    ViewData["Title"] = "Kiralama Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1 class="hero-title m-0" style="font-size: 2.2rem;">Kiralamalar</h1>
    <a asp-action="Create" class="btn btn-premium">Yeni Kiralama Ekle</a>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 mb-0" style="background: rgba(13, 202, 240, 0.1); color: #0dcaf0;">Kiralama kaydı bulunamadı.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium mb-0">
                <thead>
                    <tr>
                        <th>Müşteri</th>
                        <th>Araç</th>
                        <th>Plaka</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td style="font-weight: 500; color: var(--color-accent-gold);">@item.Customer?.Name @item.Customer?.LastName</td>
                            <td>@item.Car?.Brand @item.Car?.Model</td>
                            <td style="font-family: monospace; color: var(--color-text-muted);">@item.Car?.PlateNumber</td>
                            <td>@item.StartDate.ToShortDateString()</td>
                            <td>@item.EndDate.ToShortDateString()</td>
                            <td>
                                @if (item.IsCompleted)
                                {
                                    <span class="badge" style="background: rgba(25, 135, 84, 0.2); color: #20c997; border: 1px solid rgba(32, 201, 151, 0.3);">Tamamlandı</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: rgba(255, 193, 7, 0.2); color: #ffc107; border: 1px solid rgba(255, 193, 7, 0.3);">Devam Ediyor</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!item.IsCompleted)
                                {
                                    <a asp-action="Return" asp-route-id="@item.Id" class="btn btn-sm btn-premium-outline">İade Et</a>
                                }
                                else 
                                {
                                    <span class="text-muted" style="font-size: 0.8rem;">İşlem Yok</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
