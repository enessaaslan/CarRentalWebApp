@model IEnumerable<CarRentalWebApp.Models.Rental>

@{
    ViewData["Title"] = "Kiralamalar";
}

<h1>Kiralamalar</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Kiralama Ekle</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Kiralama kaydı bulunamadı.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Müşteri</th>
                <th>Araç</th>
                <th>Plaka</th>
                <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Customer?.Name</td>
                    <td>@item.Car?.Brand @item.Car?.Model</td>
                    <td>@item.Car?.PlateNumber</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td>
                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">Tamamlandı</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Devam Ediyor</span>
                        }
                    </td>
                    <td>
                        @if (!item.IsCompleted)
                        {
                            <a asp-action="Return" asp-route-id="@item.Id" class="btn btn-sm btn-info">İade Et</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
