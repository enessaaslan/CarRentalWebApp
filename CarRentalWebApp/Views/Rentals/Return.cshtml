@model CarRentalWebApp.Models.Rental

@{
    ViewData["Title"] = "Araç İade Et";
}

<h1 class="hero-title mb-4">Araç İade İşlemi</h1>

<h3>Bu kiralama kaydını tamamlayıp aracı iade almak istediğinize emin misiniz?</h3>
<div>
    <hr style="border-color: var(--glass-border);" />
    <dl class="row">
        <dt class="col-sm-2">Müşteri Adı</dt>
        <dd class="col-sm-10">@Model.Customer?.Name</dd>
        
        <dt class="col-sm-2">Araç</dt>
        <dd class="col-sm-10">@Model.Car?.Brand @Model.Car?.Model</dd>
        
        <dt class="col-sm-2">Plaka</dt>
        <dd class="col-sm-10">@Model.Car?.PlateNumber</dd>
        
        <dt class="col-sm-2">Kiralama Başlangıç</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>
        
        <dt class="col-sm-2">Kiralama Bitiş</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>
    </dl>
    
    <div class="alert alert-info">
        <strong>Bilgi:</strong> Bu işlemi onayladığınızda araç durumu "Müsait" olarak güncellenecektir.
    </div>

    <form asp-action="Return">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-success">İadeyi Onayla</button> |
        <a asp-action="Index" class="btn btn-outline-light ms-2">İptal</a>
    </form>
</div>

