@model IEnumerable<CarRentalWebApp.Models.Car>

@{
    ViewData["Title"] = "Premium Filo";
}

<div class="text-center py-5 mb-5 mt-4 glass-card border-0" style="background: rgba(22, 24, 31, 0.2);">
    <h1 class="display-3 hero-title mb-3">Lüksü Hisset, Yola Hükmet</h1>
    <p class="lead hero-subtitle mx-auto" style="max-width: 600px;">
        Premium araç filomuzla standartların ötesine geçin. Sizin için en uygun aracı seçin ve ayrıcalıklı kiralama deneyimini hemen yaşayın.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-card mb-5" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="hero-title m-0" style="font-size: 2.2rem;">Müsait Araçlarımız</h2>
    <span class="badge px-3 py-2" style="background: var(--color-accent-gold); color: #000; font-size: 0.9rem; font-weight: 600;">Özel Seçki</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info glass-card text-center p-5">
        <h4 class="mb-2" style="color: var(--color-text-main)">Şu anda müsait aracımız bulunmuyor.</h4>
        <p class="mb-0 text-muted">Lütfen daha sonra tekrar kontrol ediniz veya bizimle iletişime geçiniz.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5 pb-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="glass-card h-100 d-flex flex-column">
                    <div class="card-body p-4 pb-2">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title m-0" style="color: var(--color-accent-gold) !important; font-weight: 700; letter-spacing: 0.5px;">@item.Brand</h4>
                            <span class="badge" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: var(--color-text-main); font-weight: 500;">@item.Year</span>
                        </div>
                        <h5 class="card-subtitle mb-4 text-white" style="font-weight: 400; letter-spacing: 1px; font-size: 1.1rem;">@item.Model</h5>
                        
                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
                            <span class="text-muted" style="font-size: 0.9rem;">Plaka</span>
                            <span style="font-family: monospace; letter-spacing: 2px; color: var(--color-text-main); font-size: 0.95rem; background: rgba(0,0,0,0.3); padding: 4px 10px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.05);">@item.PlateNumber</span>
                        </div>
                        <div class="d-flex align-items-end justify-content-between mt-auto pt-2">
                            <span class="text-muted" style="font-size: 0.9rem; padding-bottom: 5px;">Günlük</span>
                            <span class="fs-2 fw-bold" style="color: var(--color-accent-gold); letter-spacing: -1px;">@item.DailyPrice.ToString("C")</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 p-4 pt-3 mt-auto">
                        <a asp-action="RentalRequest" asp-route-carId="@item.Id" class="btn btn-premium w-100 text-uppercase" style="letter-spacing: 1.5px; font-size: 0.9rem;">Hemen Kirala</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
